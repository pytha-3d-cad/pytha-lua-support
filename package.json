{
  "name": "pytha-lua-support",
  "displayName": "PYTHA Lua Support",
  "description": "IntelliSense, type hints and inline documentation for the PYTHA 3D-CAD Lua plugin API.",
  "version": "0.4.0",
  "publisher": "pytha-3d-cad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pytha-3d-cad/pytha-lua-support.git"
  },
  "bugs": {
    "url": "https://github.com/pytha-3d-cad/pytha-lua-support/issues"
  },
  "homepage": "https://github.com/pytha-3d-cad/pytha-lua-support#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "activationEvents": [
    "onLanguage:lua",
    "onDebugResolve:pytha-lua"
  ],
  "icon": "icon/PYTHA-Logo.png",
  "galleryBanner": {
    "color": "#555555",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "pytha",
    "lua",
    "cad",
    "3d",
    "plugin"
  ],
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "PYTHA Lua",
      "properties": {
        "pytha-lua.port": {
          "type": "number",
          "default": 4711,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port of the PYTHA Lua debug server. Must match the **Lua Debugger Port** configured in PYTHA. A `port` in the launch configuration overrides this."
        },
        "pytha-lua.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host of the PYTHA Lua debug server. A 'host' in the launch configuration overrides this."
        }
      }
    },
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/lua.json"
      }
    ],
    "commands": [
      {
        "command": "pytha.openWikiHome",
        "title": "PYTHA: Open API Wiki",
        "category": "PYTHA"
      },
      {
        "command": "pytha.openWikiForSymbol",
        "title": "PYTHA: Open wiki for symbol under cursor",
        "category": "PYTHA"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pytha.openWikiForSymbol",
          "when": "editorLangId == lua",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pytha.openWikiForSymbol",
        "key": "ctrl+f1",
        "when": "editorLangId == lua && editorTextFocus"
      }
    ],
    "xmlValidation": [
      {
        "fileMatch": "config.xml",
        "url": "./schemas/config.xsd"
      }
    ],
    "breakpoints": [
      {
        "language": "lua"
      }
    ],
    "debuggers": [
      {
        "type": "pytha-lua",
        "label": "PYTHA Lua",
        "languages": [
          "lua"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Host of the PYTHA DAP server.",
                "default": "127.0.0.1"
              },
              "port": {
                "type": "number",
                "description": "Port of the PYTHA DAP server.",
                "default": 4711
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pytha-lua",
            "request": "attach",
            "name": "PYTHA Lua (attach)",
            "host": "127.0.0.1",
            "port": 4711
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "gen:stubs": "node scripts/generate-stubs.mjs",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
